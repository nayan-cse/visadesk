# npm run setup creates a fresh key in .env.local
SESSION_ENCRYPTION_KEY=
# Optional HTTP Basic authentication: set BOTH values to require login.
APP_USERNAME=
APP_PASSWORD=
# Local server only
PORT=3000

# Optional server-side AI Vision. Keep the key server-side.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini

# Free OCR.space: email contains your own key; Engine 2 by default.
OCR_PROVIDER=ocr-space
OCR_SPACE_API_KEY=K82463007888957
OCR_SPACE_ENGINE=2
